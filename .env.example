# ==============================================================================
# DotnetArchitecture Docker Ortam Değişkenleri
# ==============================================================================

# SQL Server SA Kullanıcı Şifresi (En az 8 karakter, büyük/küçük harf, rakam ve özel karakter)
MSSQL_SA_PASSWORD=YourPassword123.

# Dışarıya Açılan SQL Server Portu (Varsayılan: 1433)
MSSQL_PORT=1433

# Dışarıya Açılan Redis Dağıtık Önbellek Portu (Varsayılan: 6379)
REDIS_PORT=6379

# Dışarıya Açılan Web API Portu (Varsayılan: 5294)
WEBAPI_PORT=5294
